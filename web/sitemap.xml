<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only the pages that exist as real, linkable destinations for someone who
  isn't signed in. Activity and profile pages are public too, but they're
  generated from the database, so listing them needs a build step that can
  query the API — worth doing once there's enough content to matter.

  Blog posts are the first thing that hit that bar: scripts/build-blog.js
  appends /blog/ and one entry per published post into this exact file
  during the deploy build, right after it's copied in — see the "Build blog
  pages" step in deploy-pages.yml. The 5 URLs below stay hand-maintained.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://spurth.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://spurth.com/signup</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://spurth.com/login</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://spurth.com/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://spurth.com/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
