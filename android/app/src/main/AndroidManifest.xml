<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <!-- Posting a video needs its own grant on Android 13+; without it the
       picker returns nothing and the upload silently has no file. -->
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
  <!-- Android 13+ requires an explicit runtime grant before an app can
       post a notification at all. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Pre-13 devices fall back to the storage permission, which was
       replaced by the READ_MEDIA_* pair above. -->
  <uses-permission
    android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="32" />

  <application
    android:name=".MainApplication"
    android:networkSecurityConfig="@xml/network_security_config"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:supportsRtl="true">

    <uses-library
      android:name="org.apache.http.legacy"
      android:required="false" />

    <meta-data
      android:name="com.google.android.geo.API_KEY"
      android:value="AIzaSyA3_dtp1rNdfWEWaEfEZBPrPKtfL1ddlsk" />

    <!-- FCM shows a push under this channel id on Android 8+; the backend
         sends every push with channel_id='default' (api/push.py) so this
         has to match, or Android silently drops the notification instead
         of falling back to some default channel. ic_launcher is a
         placeholder — Android prefers a flat white/transparent icon for
         the status bar, worth swapping in once there's a proper one. -->
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_channel_id"
      android:value="default" />
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_icon"
      android:resource="@mipmap/ic_launcher" />

    <activity
      android:name=".MainActivity"
      android:label="@string/app_name"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
      android:exported="true"
      android:theme="@style/BootTheme">

      <!-- Launcher -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!-- Deep Linking — any spurth://<host>/... URL (verify-email, profile,
           event, ...); parseDeepLink() in AppNavigator.js routes by host,
           so this intent-filter doesn't need to enumerate them. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="spurth" />
      </intent-filter>

    </activity>
  </application>
</manifest>